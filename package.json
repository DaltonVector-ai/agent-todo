{
	"name": "agent-todo",
	"version": "1.0.0-rc.1",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "bun test packages/*/src test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc -b",
		"build:bin": "bun run scripts/build-binaries.ts",
		"build:bin:all": "bun run scripts/build-binaries.ts --all",
		"release:checksums": "bun run scripts/checksums.ts",
		"release:sbom": "bun run scripts/sbom.ts",
		"docs:tool-reference": "bun run scripts/generate-tool-reference.ts",
		"test:load:local": "AGENT_TODO_LOAD_FULL=1 bun test test/load/local-sqlite-load.test.ts",
		"cli": "bun run packages/cli/src/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@modelcontextprotocol/sdk": "^1.18.1",
		"@types/bun": "^1.2.21",
		"typescript": "^5.9.2",
		"ulid": "^3.0.1"
	}
}
